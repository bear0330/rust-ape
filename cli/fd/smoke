#!/bin/sh
set -eu
bin=${1:?fd binary required}
dir=$(mktemp -d)
trap 'rm -rf "$dir"' EXIT HUP INT TERM
printf 'note\n' > "$dir/note.txt"
out=$(bash "$bin" --no-ignore note.txt "$dir")
printf '%s\n' "$out"
printf '%s\n' "$out" | grep -F -q 'note.txt'
ver=$(bash "$bin" --version)
printf '%s\n' "$ver"
printf '%s\n' "$ver" | grep -F -q 'fd 10.2.0'
